{
  "name": "@interop/ecdsa-signature",
  "version": "2.0.1",
  "description": "ECDSA Data Integrity cryptosuites (ecdsa-rdfc-2019, ecdsa-jcs-2019) in TypeScript.",
  "homepage": "https://github.com/interop-alliance/ecdsa-signature",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interop-alliance/ecdsa-signature.git"
  },
  "bugs": "https://github.com/interop-alliance/ecdsa-signature/issues",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ecdsa-rdfc-2019": {
      "types": "./dist/ecdsa-rdfc-2019/index.d.ts",
      "default": "./dist/ecdsa-rdfc-2019/index.js"
    },
    "./ecdsa-jcs-2019": {
      "types": "./dist/ecdsa-jcs-2019/index.d.ts",
      "default": "./dist/ecdsa-jcs-2019/index.js"
    }
  },
  "browser": {
    "./dist/core/sha.js": "./dist/core/sha-browser.js"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clear && tsc",
    "clear": "rimraf dist/*",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.dev.json --noEmit",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "test": "pnpm run fix && pnpm run lint && pnpm run test:node && pnpm run test:browser",
    "test:node": "vitest run",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@interop/ecdsa-multikey": "^2.0.1",
    "@interop/jsonld": "^9.0.2",
    "canonicalize": "^2.0.0",
    "rdf-canonize": "^5.0.0"
  },
  "peerDependencies": {
    "@interop/jsonld-signatures": "^11.6.7"
  },
  "peerDependenciesMeta": {
    "@interop/jsonld-signatures": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@interop/data-integrity-core": "^6.1.2",
    "@interop/data-integrity-proof": "^3.2.2",
    "@interop/did-io": "^4.0.2",
    "@interop/did-method-key": "^7.2.0",
    "@interop/jsonld-signatures": "^11.6.7",
    "@interop/security-document-loader": "^9.2.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@11.3.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
